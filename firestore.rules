rules_version = '2';

// Matches the data model actually implemented in
// lib/services/cloud_backup_service.dart (docs/TECHNICAL_ARCHITECTURE.md SS5) —
// one document per user rather than the subcollection sketch originally
// drafted, since a single-document transaction is what makes the
// highest-value-wins merge in CloudBackupService atomic and simple.
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validLeaderboardEntry() {
      return request.resource.data.keys()
          .hasAll(['name', 'score', 'level', 'updatedAt'])
        && request.resource.data.keys()
          .hasOnly(['name', 'score', 'level', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.name.size() <= 20
        && request.resource.data.name.matches(
          '^[A-Za-z0-9][A-Za-z0-9 _-]{1,18}[A-Za-z0-9]$'
        )
        && request.resource.data.score is int
        && request.resource.data.score > 0
        && request.resource.data.score <= 10000000
        && request.resource.data.level is int
        && request.resource.data.level >= 1
        && request.resource.data.level <= 1000
        && request.resource.data.updatedAt == request.time;
    }

    function validLeaderboardUpdate(uid) {
      return owns(uid)
        && validLeaderboardEntry()
        && (
          (request.resource.data.score > resource.data.score
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'name',
                'score',
                'level',
                'updatedAt',
                // A first direct write may remove fields left by the old callable.
                'seed',
                'accountType',
                'submittedAt'
              ]))
          || (request.resource.data.score == resource.data.score
            && request.resource.data.level == resource.data.level
            && (!('name' in resource.data)
              || request.resource.data.name != resource.data.name)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'name',
                'updatedAt',
                'seed',
                'accountType',
                'submittedAt'
              ]))
        );
    }

    match /users/{uid} {
      // The owner can read/write their own document, but never the
      // `entitlements` field. VIP is disabled, and this field is reserved
      // for a future trusted purchase-verification service; the current
      // no-Functions client cannot write it.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && !('entitlements' in request.resource.data);
      allow update: if request.auth != null
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['entitlements']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Lightweight client-written leaderboards: a Firebase player may create
    // only their own tiny entry, including any 2 Player variant. Scores
    // must increase; a player may
    // also change only the public name attached to an unchanged score.
    // This minimizes writes, but cannot make a modified client cheat-proof.
    match /leaderboards/{mode}/entries/{uid} {
      allow read: if request.auth != null;
      allow create: if mode in ['chill', 'multiplayer', 'multiplayerMirror', 'multiplayerPuzzle']
        && owns(uid)
        && validLeaderboardEntry();
      allow update: if mode in ['chill', 'multiplayer', 'multiplayerMirror', 'multiplayerPuzzle']
        && validLeaderboardUpdate(uid);
    }

    match /dailyChallenge/{date}/entries/{uid} {
      allow read: if request.auth != null;
      allow create: if date.matches('20[0-9]{6}')
        && owns(uid)
        && validLeaderboardEntry();
      allow update: if date.matches('20[0-9]{6}')
        && validLeaderboardUpdate(uid);
    }

    // Short-code WebRTC signaling. Gathered ICE candidates are bundled into
    // the single SDP offer/answer fields, so no candidate subcollections are
    // written. Game traffic uses the direct data channel after connection.
    match /multiplayerRooms/{roomCode} {
      function signedIn() {
        return request.auth != null;
      }

      function isHost() {
        return signedIn() && resource.data.hostUid == request.auth.uid;
      }

      function isGuest() {
        return signedIn()
          && ('guestUid' in resource.data)
          && resource.data.guestUid == request.auth.uid;
      }

      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && !('guestUid' in request.resource.data)
        && (!('variant' in request.resource.data)
          || request.resource.data.variant in ['fixed', 'mirror', 'puzzle']);
      allow update: if signedIn()
        && request.resource.data.hostUid == resource.data.hostUid
        && (
          (isHost()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['offer', 'status', 'updatedAt', 'expiresAt']))
          || (isGuest()
            && request.resource.data.guestUid == resource.data.guestUid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['answer', 'status', 'updatedAt']))
          || (!('guestUid' in resource.data)
            && request.resource.data.guestUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['guestUid', 'status', 'updatedAt']))
        );
      allow delete: if isHost();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
